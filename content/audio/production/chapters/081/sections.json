      "id": "01",
      "slug": "yingchun-farewell",
      "startAnchor": "第八十一回 惜昵近公子做良媒 讳笞罚丫鬟结恶党",
      "endAnchor": "仍到炕上闭目歇息。",
      "targetOverrides": {
        "narration:081-b0001:u01": {
          "retryVersion": 1,
          "instructionSuffix": "回目按惜昵近、公子做良媒、会吃罚、丫鬟结恶党四个意群读；会吃罚按给定合成文字发音。"
        },
        "narration:081-b0004:u01": {
          "retryVersion": 1,
          "instructionSuffix": "也不便多言之后紧接只得忍悲作辞，不留长停；全段克制、连贯。"
        },
        "narration:081-b0012:u01": {
          "retryVersion": 2,
          "promptMode": "strict-text",
          "instructionSuffix": "王夫人道只念一遍，末尾立即结束，不得重复。"
        },
        "narration:081-b0233:u01": {
          "retryVersion": 1,
          "instructionSuffix": "这是一句极短的旁白，请以正常可闻的音量清楚念完，不能用气声，也不要留下长时间静音。"
        },
        "narration:081-b0010:u01": {
          "retryVersion": 1,
          "instructionSuffix": "这是一句极短的旁白，请以正常可闻的音量清楚念完，不能用气声，也不要留下长时间静音。"
        },
        "dialogue:081-b0018:u04": {
          "retryVersion": 1,
          "instructionSuffix": "“反要受”须按 fǎn yào shòu 清楚连读，尤其“要”不能念成“而”；不要额外加字，整体仍须连贯、难过且中速略快。"
        }
      },
