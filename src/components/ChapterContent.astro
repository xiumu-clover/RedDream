---
import type { CompiledChapter } from '../lib/chapter-compiler';
import { renderChapterHtml } from '../lib/chapter-compiler';
import type { BookId } from '../lib/books';
import { DEFAULT_READING_PREFERENCES } from '../lib/reading-preferences';

interface Props {
	chapter: CompiledChapter;
	book: BookId;
}

const { chapter, book } = Astro.props;
const { bodyHtml, endnotesHtml } = renderChapterHtml(chapter);
const defaultSettings = DEFAULT_READING_PREFERENCES[book];
---

<article
	class="chapter-content"
	data-chapter-content
	data-book={book}
	data-hide-zp={String(!defaultSettings.showZp)}
	data-hide-mp={String(!defaultSettings.showMp)}
	data-hide-notes={String(!defaultSettings.showNotes)}
	data-compact={String(defaultSettings.compact)}
>
	<div class="chapter-content__body" set:html={bodyHtml}></div>
	<div class="chapter-content__endnotes" set:html={endnotesHtml}></div>
</article>

<script>
	import { BOOKS, isBookId } from '../lib/books';
	import { loadReadingPreferences } from '../lib/reading-preferences';

	const getOpenAnchor = () =>
		document.querySelector<HTMLButtonElement>('.chapter-note__anchor[aria-expanded="true"]');

	const closeNote = (anchor: HTMLButtonElement, restoreFocus = false) => {
		const note = anchor.closest<HTMLElement>('[data-chapter-note]');
		const popover = note?.querySelector<HTMLElement>('.chapter-note__popover');
		anchor.setAttribute('aria-expanded', 'false');
		if (popover) {
			popover.hidden = true;
			popover.style.removeProperty('left');
			popover.style.removeProperty('top');
			popover.style.removeProperty('width');
		}
		if (restoreFocus) anchor.focus();
	};

	const preferences = loadReadingPreferences();

	const applyReadingSettings = () => {
		document.querySelectorAll<HTMLElement>('[data-chapter-content]').forEach((chapter) => {
			const book = chapter.dataset.book;
			if (!isBookId(book)) return;
			const settings = preferences[book];
			chapter.dataset.hideZp = String(!settings.showZp);
			chapter.dataset.hideMp = String(!settings.showMp);
			chapter.dataset.hideNotes = String(!settings.showNotes);
			chapter.dataset.compact = String(settings.compact);
		});

		if (document.querySelector('[data-hide-notes="true"]')) {
			const currentlyOpen = getOpenAnchor();
			if (currentlyOpen) closeNote(currentlyOpen);
		}
	};

	const isContinuousPage = document.querySelector('[data-all-chapters]') !== null;
	applyReadingSettings();

	const firstChapterBook = document.querySelector<HTMLElement>('[data-chapter-content]')?.dataset.book;
	if (!isContinuousPage && isBookId(firstChapterBook) && preferences[firstChapterBook].continuous) {
		window.location.replace(BOOKS[firstChapterBook].continuousHref);
	}

	const positionPopover = (anchor: HTMLButtonElement, popover: HTMLElement) => {
		const viewportPadding = 12;
		const gap = 9;
		const anchorRect = anchor.getBoundingClientRect();
		const width = Math.min(288, window.innerWidth - viewportPadding * 2);
		popover.style.width = `${width}px`;

		const popoverHeight = popover.getBoundingClientRect().height;
		const centeredLeft = anchorRect.left + anchorRect.width / 2 - width / 2;
		const left = Math.min(
			Math.max(centeredLeft, viewportPadding),
			window.innerWidth - width - viewportPadding,
		);
		const below = anchorRect.bottom + gap;
		const top = below + popoverHeight <= window.innerHeight - viewportPadding
			? below
			: Math.max(viewportPadding, anchorRect.top - popoverHeight - gap);

		popover.style.left = `${left}px`;
		popover.style.top = `${top}px`;
	};

	let imageLightboxOpener: HTMLButtonElement | null = null;

	const ensureImageLightbox = (): HTMLDialogElement => {
		const existing = document.querySelector<HTMLDialogElement>('[data-chapter-image-lightbox]');
		if (existing) return existing;

		const dialog = document.createElement('dialog');
		dialog.className = 'chapter-image-lightbox';
		dialog.dataset.chapterImageLightbox = '';
		dialog.setAttribute('aria-label', '图片放大查看');

		const frame = document.createElement('div');
		frame.className = 'chapter-image-lightbox__frame';

		const closeButton = document.createElement('button');
		closeButton.className = 'chapter-image-lightbox__close';
		closeButton.type = 'button';
		closeButton.dataset.chapterImageLightboxClose = '';
		closeButton.setAttribute('aria-label', '关闭大图');
		closeButton.textContent = '关闭';

		const image = document.createElement('img');
		image.className = 'chapter-image-lightbox__image';
		image.dataset.chapterImageLightboxImage = '';
		image.alt = '';

		const caption = document.createElement('p');
		caption.className = 'chapter-image-lightbox__caption';
		caption.dataset.chapterImageLightboxCaption = '';
		caption.hidden = true;

		frame.append(closeButton, image, caption);
		dialog.append(frame);
		document.body.append(dialog);

		closeButton.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener('close', () => {
			document.body.classList.remove('chapter-image-lightbox-open');
			image.removeAttribute('src');
			caption.textContent = '';
			caption.hidden = true;
			if (imageLightboxOpener?.isConnected) imageLightboxOpener.focus();
			imageLightboxOpener = null;
		});

		return dialog;
	};

	const openImageLightbox = (opener: HTMLButtonElement) => {
		const figure = opener.closest<HTMLElement>('[data-chapter-image]');
		const sourceImage = opener.querySelector<HTMLImageElement>('img');
		if (!figure || !sourceImage) return;

		const dialog = ensureImageLightbox();
		const lightboxImage = dialog.querySelector<HTMLImageElement>('[data-chapter-image-lightbox-image]');
		const lightboxCaption = dialog.querySelector<HTMLElement>('[data-chapter-image-lightbox-caption]');
		const closeButton = dialog.querySelector<HTMLButtonElement>('[data-chapter-image-lightbox-close]');
		if (!lightboxImage || !lightboxCaption || !closeButton) return;

		const caption = figure.querySelector<HTMLElement>('.chapter-image__caption')?.textContent?.trim() ?? '';
		lightboxImage.src = sourceImage.currentSrc || sourceImage.src;
		lightboxImage.alt = sourceImage.alt;
		lightboxCaption.textContent = caption;
		lightboxCaption.hidden = caption.length === 0;
		imageLightboxOpener = opener;
		document.body.classList.add('chapter-image-lightbox-open');
		dialog.showModal();
		closeButton.focus();
	};

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const anchor = target.closest<HTMLButtonElement>('.chapter-note__anchor');
		if (anchor) {
			const wasOpen = anchor.getAttribute('aria-expanded') === 'true';
			const currentlyOpen = getOpenAnchor();
			if (currentlyOpen) closeNote(currentlyOpen);
			if (wasOpen) return;

			const note = anchor.closest<HTMLElement>('[data-chapter-note]');
			const popover = note?.querySelector<HTMLElement>('.chapter-note__popover');
			if (!popover) return;
			anchor.setAttribute('aria-expanded', 'true');
			popover.hidden = false;
			positionPopover(anchor, popover);
			return;
		}

		const imageOpener = target.closest<HTMLButtonElement>('[data-chapter-image-open]');
		if (imageOpener) {
			const currentlyOpen = getOpenAnchor();
			if (currentlyOpen) closeNote(currentlyOpen);
			openImageLightbox(imageOpener);
			return;
		}

		if (!target.closest('[data-chapter-note]')) {
			const currentlyOpen = getOpenAnchor();
			if (currentlyOpen) closeNote(currentlyOpen);
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		const currentlyOpen = getOpenAnchor();
		if (currentlyOpen) closeNote(currentlyOpen, true);
	});

	window.addEventListener('resize', () => {
		const currentlyOpen = getOpenAnchor();
		if (currentlyOpen) closeNote(currentlyOpen);
	});

	window.addEventListener('scroll', () => {
		const currentlyOpen = getOpenAnchor();
		if (currentlyOpen) closeNote(currentlyOpen);
	}, { passive: true });
</script>
