---
import type { BookId } from '../../lib/books/catalog';

export interface AudioVariant {
	url: string;
	trackHash?: string;
	bytes?: number;
	durationSeconds?: number;
}

type AudioVariantName = 'narrator' | 'female' | 'male';

export interface ChapterAudioRecord {
	defaultVariant: AudioVariantName;
	variants: Partial<Record<AudioVariantName, AudioVariant>>;
}

interface Props {
	book: BookId;
	chapterId: string;
	record?: ChapterAudioRecord;
}

const { chapterId, record } = Astro.props;
const variantNames: AudioVariantName[] = record
	? [record.defaultVariant, 'narrator', 'female', 'male']
	: [];
const selectedVariantName = variantNames.find((name, index) => (
	variantNames.indexOf(name) === index && record?.variants?.[name]
));
const initial = selectedVariantName ? record?.variants?.[selectedVariantName] : undefined;
const variantLabel = selectedVariantName === 'female'
	? '女声旁白'
	: selectedVariantName === 'male'
		? '男声旁白'
		: 'Yunjian 旁白';
const versionedUrl = (variant?: AudioVariant) => variant
	? `${variant.url}${variant.url.includes('?') ? '&' : '?'}v=${encodeURIComponent((variant.trackHash || 'current').slice(0, 16))}`
	: undefined;
---

{
	initial && (
		<section
			class="chapter-audio"
			aria-labelledby={`chapter-audio-${chapterId}`}
		>
			<div class="chapter-audio__heading">
				<div>
					<p>AI 有声书</p>
					<h2 id={`chapter-audio-${chapterId}`}>第 {Number(chapterId)} 回</h2>
				</div>
				<p>{variantLabel}</p>
			</div>
			<audio controls preload="metadata" src={versionedUrl(initial)}>
				当前浏览器不支持音频播放。
			</audio>
		</section>
	)
}
