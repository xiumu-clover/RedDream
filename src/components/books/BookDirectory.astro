---
import { BOOKS, formatChapterOrder, type BookId } from '../../lib/books/catalog';
import PicturebookLinks from './PicturebookLinks.astro';

interface ChapterItem {
	id: string;
	order?: number;
	title: string;
	description?: string;
}

interface Props {
	book: BookId;
	chapters: ChapterItem[];
}

const { book, chapters } = Astro.props;
const definition = BOOKS[book];
---

<header class="page-heading book-directory-heading">
	<div class:list={['book-directory-heading__top', { 'book-directory-heading__top--with-picturebook': book === 'guiyou' }]}>
		<div>
			<p class="eyebrow">{definition.range}</p>
			<h1>{definition.title}</h1>
			<p class="book-directory-heading__intro">{definition.description}</p>
		</div>
		{book === 'guiyou' && <PicturebookLinks />}
	</div>
	<div class="book-directory-heading__meta">
		<span>{definition.rangeDetail}</span>
		<a href={definition.continuousHref}>连续阅读本册</a>
	</div>
</header>

{
	chapters.length > 0 ? (
		<ol class="chapter-list">
			{chapters.map((chapter) => (
				<li data-chapter-number={formatChapterOrder(chapter.order)}>
					<div>
						<h2><a href={`/chapters/${chapter.id}/`}>{chapter.title}</a></h2>
						{chapter.description && <p>{chapter.description}</p>}
					</div>
				</li>
			))}
		</ol>
	) : (
		<p class="empty-state">本册还没有可阅读的回目。</p>
	)
}

<style>
	.book-directory-heading__top--with-picturebook {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(15.5rem, 18rem);
		align-items: center;
		gap: 2rem;
	}

	@media (max-width: 48rem) {
		.book-directory-heading__top--with-picturebook {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}
	}

	@media print {
		.book-directory-heading__top--with-picturebook {
			display: block;
		}
	}
</style>
