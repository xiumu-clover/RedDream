---
import ChapterContent from '../../components/chapters/ChapterContent.astro';
import PageShell from '../../components/layout/PageShell.astro';
import { loadCompiledChapters } from '../../lib/chapters/collection';

const chapters = (await loadCompiledChapters())
	.filter(({ book }) => book !== 'guiyou-original');
---

<PageShell title="全书连续阅读" description="按顺序连续阅读并打印全部回目。">
	<div class="continuous-reading" data-all-chapters>
		{
			chapters.map(({ id, chapter, book }) => (
				<section class="continuous-chapter" id={`chapter-${id}`} aria-label={chapter.title}>
					<ChapterContent chapter={chapter} book={book} />
				</section>
			))
		}
	</div>
</PageShell>
