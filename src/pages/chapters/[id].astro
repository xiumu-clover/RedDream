---
import ChapterContent from '../../components/chapters/ChapterContent.astro';
import ChapterNavigation from '../../components/chapters/ChapterNavigation.astro';
import PageShell from '../../components/layout/PageShell.astro';
import { BOOKS, type BookId } from '../../lib/books/catalog';
import { loadCompiledChapter, loadCompiledChapters } from '../../lib/chapters/collection';

interface ChapterLink {
	id: string;
	title: string;
}

export async function getStaticPaths() {
	const chapters = await loadCompiledChapters();
	return chapters.map((preparedChapter, index, allChapters) => {
		const bookChapters = allChapters.filter(({ book }) => book === preparedChapter.book);
		const bookIndex = bookChapters.findIndex(({ id }) => id === preparedChapter.id);
		return {
			params: { id: preparedChapter.id },
			props: {
				book: preparedChapter.book,
				sourceId: preparedChapter.sourceId,
				previous: bookIndex > 0
					? { id: bookChapters[bookIndex - 1].id, title: bookChapters[bookIndex - 1].chapter.title }
					: undefined,
				next: bookIndex < bookChapters.length - 1
					? { id: bookChapters[bookIndex + 1].id, title: bookChapters[bookIndex + 1].chapter.title }
					: undefined,
			},
		};
	});
}

interface Props {
	book: BookId;
	sourceId: string;
	previous?: ChapterLink;
	next?: ChapterLink;
}

const { book, sourceId, previous, next } = Astro.props;
const preparedChapter = await loadCompiledChapter(book, sourceId);
if (!preparedChapter) throw new Error(`找不到章节：${Astro.params.id ?? ''}`);

const { description, chapter } = preparedChapter;
const definition = BOOKS[book];
---

<PageShell title={chapter.title} description={description} activeSection={book}>
	<ChapterContent chapter={chapter} book={book} />
	<ChapterNavigation
		previous={previous}
		next={next}
		directoryHref={definition.href}
		directoryLabel={`返回${definition.title}目录`}
	/>
</PageShell>
