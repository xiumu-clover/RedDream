---
import ChapterContent from '../../components/chapters/ChapterContent.astro';
import AudioPlayer, { type ChapterAudioRecord } from '../../components/chapters/AudioPlayer.astro';
import ChapterNavigation from '../../components/chapters/ChapterNavigation.astro';
import PageShell from '../../components/layout/PageShell.astro';
import { BOOKS, BOOK_IDS } from '../../lib/books/catalog';
import type { PreparedChapter } from '../../lib/chapters/collection';
import { loadCompiledChapters } from '../../lib/chapters/collection';
import audioManifest from '../../../public/audio/manifest.json';

interface ChapterLink {
	id: string;
	title: string;
}

export async function getStaticPaths() {
	const chapters = await loadCompiledChapters();

	return BOOK_IDS.flatMap((book) => {
		const bookChapters = chapters.filter((chapter) => chapter.book === book);
		return bookChapters.map((preparedChapter, index) => ({
			params: { id: preparedChapter.id },
			props: {
				preparedChapter,
				previous: index > 0
					? { id: bookChapters[index - 1].id, title: bookChapters[index - 1].chapter.title }
					: undefined,
				next: index < bookChapters.length - 1
					? { id: bookChapters[index + 1].id, title: bookChapters[index + 1].chapter.title }
					: undefined,
			},
		}));
	});
}

interface Props {
	preparedChapter: PreparedChapter;
	previous?: ChapterLink;
	next?: ChapterLink;
}

const { preparedChapter: { order, description, chapter, book }, previous, next } = Astro.props;
const definition = BOOKS[book];
const audioId = String(order).padStart(3, '0');
const manifest = audioManifest as {
	version: number;
	chapters: Record<string, ChapterAudioRecord | undefined>;
};
const audioRecord = definition.hasAudio && manifest.version === 2
	? manifest.chapters[audioId]
	: undefined;
---

<PageShell title={chapter.title} description={description} activeSection={book}>
	<AudioPlayer book={book} chapterId={audioId} record={audioRecord} />
	<ChapterContent chapter={chapter} book={book} />
	<ChapterNavigation
		previous={previous}
		next={next}
		directoryHref={definition.href}
		directoryLabel={`返回${definition.title}目录`}
	/>
</PageShell>
