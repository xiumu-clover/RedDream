---
import { getCollection } from 'astro:content';
import PageShell from '../components/PageShell.astro';
import { formatChapterOrder } from '../lib/books';
import { compileChapter } from '../lib/chapter-compiler';
import { validateChapterImages } from '../lib/chapter-images';

const chapters = (await Promise.all(
	(await getCollection('chapters')).map(async (entry) => {
		const compiled = compileChapter(entry.body ?? '', {
			sourceName: `content/chapters/${entry.id}.md`,
		});
		await validateChapterImages(compiled);
		return { entry, compiled };
	}),
))
	.sort((a, b) => {
		const orderA = a.entry.data.order ?? Number.MAX_SAFE_INTEGER;
		const orderB = b.entry.data.order ?? Number.MAX_SAFE_INTEGER;

		return orderA - orderB || a.compiled.title.localeCompare(b.compiled.title, 'zh-CN', { numeric: true });
	});
---

<PageShell title="总目录" description="按顺序浏览全部章节。">
	<header class="page-heading">
		<p class="eyebrow">Chapters</p>
		<h1>总目录</h1>
		<p class="chapter-count">共 {chapters.length} 篇章节</p>
	</header>

	{
		chapters.length > 0 ? (
			<ol class="chapter-list">
				{chapters.map(({ entry, compiled }) => (
					<li data-chapter-number={formatChapterOrder(entry.data.order)}>
						<div>
							<h2><a href={`/chapters/${entry.id}/`}>{compiled.title}</a></h2>
							{entry.data.description && <p>{entry.data.description}</p>}
						</div>
					</li>
				))}
			</ol>
		) : (
			<p class="empty-state">还没有章节。在 content/chapters/ 中添加 Markdown 文件后，标题会自动出现在这里。</p>
		)
	}
</PageShell>
