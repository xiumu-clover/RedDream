---
import ChapterContent from '../../components/chapters/ChapterContent.astro';
import PageShell from '../../components/layout/PageShell.astro';
import { BOOKS, BOOK_IDS, type BookId } from '../../lib/books/catalog';
import type { PreparedChapter } from '../../lib/chapters/collection';
import { loadCompiledChapters } from '../../lib/chapters/collection';

export async function getStaticPaths() {
	const chapters = await loadCompiledChapters();
	return BOOK_IDS.map((book) => ({
		params: { book },
		props: { book, chapters: chapters.filter((chapter) => chapter.book === book) },
	}));
}

interface Props {
	book: BookId;
	chapters: PreparedChapter[];
}

const { book, chapters } = Astro.props;
const definition = BOOKS[book];
---

<PageShell title={`${definition.title} · 连续阅读`} description={`连续阅读${definition.rangeDetail}。`} activeSection={book}>
	<header class="continuous-reading-heading">
		<p>{definition.range}</p>
		<a href={definition.href}>返回{definition.title}目录</a>
	</header>
	<div class="continuous-reading" data-all-chapters data-continuous-book={book}>
		{
			chapters.map(({ id, chapter }) => (
				<section class="continuous-chapter" id={`chapter-${id}`} aria-label={chapter.title}>
					<ChapterContent chapter={chapter} book={book} />
				</section>
			))
		}
	</div>
</PageShell>
