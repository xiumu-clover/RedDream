---
import type { BookId } from '../../lib/books/catalog';
import { BOOK_IDS } from '../../lib/books/catalog';
import BookDirectoryPage from '../../components/books/BookDirectoryPage.astro';

export async function getStaticPaths() {
	return BOOK_IDS.map((book) => ({ params: { book } }));
}

const book = Astro.params.book as BookId;
---

<BookDirectoryPage book={book} />
